
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sweet Treats - Online Cake Ordering</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #fff8f3;
    color: #422b32;
}

header {
    background: #8e2455;
    color: white;
    padding: 20px;
    text-align: center;
}

header h1 {
    margin-bottom: 8px;
}

nav {
    background: #f6b8c9;
    padding: 13px;
    text-align: center;
}

nav a {
    color: #572039;
    text-decoration: none;
    font-weight: bold;
    margin: 8px;
    display: inline-block;
}

nav a:hover {
    color: #ffffff;
    background: #8e2455;
    padding: 5px;
    border-radius: 5px;
}

section {
    padding: 25px;
    margin: 15px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px #ead8de;
}

h2 {
    color: #8e2455;
    margin-bottom: 15px;
}

input, select, textarea {
    width: 100%;
    padding: 10px;
    margin: 7px 0 12px;
    border: 1px solid #d6b7c2;
    border-radius: 6px;
}

button {
    background: #e85d75;
    color: white;
    border: none;
    padding: 10px 15px;
    border-radius: 6px;
    cursor: pointer;
    margin: 4px;
}

button:hover {
    background: #8e2455;
}

.cake-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

.cake-card {
    background: #fff0f4;
    border-radius: 12px;
    padding: 15px;
    text-align: center;
    border: 1px solid #f2c8d5;
}

.cake-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 8px;
}

.cake-card h3 {
    margin: 10px 0;
    color: #8e2455;
}

.price {
    color: #16805d;
    font-size: 18px;
    font-weight: bold;
    margin: 10px;
}

footer {
    background: #8e2455;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 20px;
}

.status {
    color: #16805d;
    font-weight: bold;
}

@media (max-width: 600px) {
    section {
        margin: 8px;
        padding: 16px;
    }

    nav a {
        margin: 5px;
    }
}
</style>
</head>

<body>

<header>
    <h1>🎂 Sweet Treats Cake Shop</h1>
    <p>Fresh Cakes for Every Celebration</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#register">Register</a>
    <a href="#login">Login</a>
    <a href="#cakes">Search Cakes</a>
    <a href="#cart">Cart</a>
    <a href="#shipping">Shipping</a>
    <a href="#orders">My Orders</a>
    <a href="#admin">Admin</a>
</nav>

<section id="home">
    <h2>Welcome to Sweet Treats</h2>
    <p>
        Buy delicious cakes online for birthdays, weddings, anniversaries,
        and other special occasions. Choose your favorite cake, customize
        your order, and provide your delivery address.
    </p>
</section>

<section id="register">
    <h2>Student / User Registration</h2>
    <form>
        <label>Full Name</label>
        <input type="text" placeholder="Enter your name" required>

        <label>Email Address</label>
        <input type="email" placeholder="Enter your email" required>

        <label>Phone Number</label>
        <input type="tel" placeholder="Enter phone number" required>

        <label>Password</label>
        <input type="password" placeholder="Create password" required>

        <button type="submit">Register</button>
    </form>
</section>

<section id="login">
    <h2>User Login</h2>
    <form>
        <label>Email</label>
        <input type="email" placeholder="Enter email" required>

        <label>Password</label>
        <input type="password" placeholder="Enter password" required>

        <button type="submit">Login</button>
    </form>
</section>

<section id="cakes">
    <h2>Search and Filter Cakes</h2>

    <input type="search" id="searchCake"
           placeholder="Search cake by name..."
           oninput="filterCakes()">

    <label>Category</label>
    <select id="category" onchange="filterCakes()">
        <option value="all">All Categories</option>
        <option value="Birthday">Birthday</option>
        <option value="Chocolate">Chocolate</option>
        <option value="Wedding">Wedding</option>
        <option value="Fruit">Fruit</option>
    </select>

    <label>Subcategory / Flavor</label>
    <select id="flavor" onchange="filterCakes()">
        <option value="all">All Flavors</option>
        <option value="Chocolate">Chocolate</option>
        <option value="Vanilla">Vanilla</option>
        <option value="Strawberry">Strawberry</option>
        <option value="Black Forest">Black Forest</option>
    </select>

    <label>Maximum Price</label>
    <select id="maxPrice" onchange="filterCakes()">
        <option value="5000">Any Price</option>
        <option value="500">Up to ₹500</option>
        <option value="800">Up to ₹800</option>
        <option value="1200">Up to ₹1,200</option>
    </select>

    <h2>Available Cakes</h2>

    <div class="cake-container" id="cakeList">

        <div class="cake-card" data-name="Chocolate Cake"
             data-category="Chocolate" data-flavor="Chocolate" data-price="500">
            <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=500"
                 alt="Chocolate cake">
            <h3>Chocolate Cake</h3>
            <p>Category: Chocolate</p>
            <p>Flavor: Chocolate</p>
            <p>Rich chocolate cream cake for every celebration.</p>
            <p class="price">₹500</p>
            <button onclick="selectCake('Chocolate Cake',500)">Add to Cart</button>
        </div>

        <div class="cake-card" data-name="Birthday Cake"
             data-category="Birthday" data-flavor="Vanilla" data-price="700">
            <img src="https://images.unsplash.com/photo-1464349095431-e9a21285b5f3?w=500"
                 alt="Birthday cake">
            <h3>Birthday Cake</h3>
            <p>Category: Birthday</p>
            <p>Flavor: Vanilla</p>
            <p>A soft vanilla cake for birthday celebrations.</p>
            <p class="price">₹700</p>
            <button onclick="selectCake('Birthday Cake',700)">Add to Cart</button>
        </div>

        <div class="cake-card" data-name="Strawberry Cake"
             data-category="Fruit" data-flavor="Strawberry" data-price="800">
            <img src="https://images.unsplash.com/photo-1565958011703-44f9829ba187?w=500"
                 alt="Strawberry cake">
            <h3>Strawberry Cake</h3>
            <p>Category: Fruit</p>
            <p>Flavor: Strawberry</p>
            <p>Fresh strawberry cream with a soft sponge.</p>
            <p class="price">₹800</p>
            <button onclick="selectCake('Strawberry Cake',800)">Add to Cart</button>
        </div>

        <div class="cake-card" data-name="Wedding Cake"
             data-category="Wedding" data-flavor="Vanilla" data-price="1200">
            <img src="https://images.unsplash.com/photo-1535254973040-607b474cb50d?w=500"
                 alt="Wedding cake">
            <h3>Wedding Cake</h3>
            <p>Category: Wedding</p>
            <p>Flavor: Vanilla</p>
            <p>A beautiful cake for your special day.</p>
            <p class="price">₹1,200</p>
            <button onclick="selectCake('Wedding Cake',1200)">Add to Cart</button>
        </div>

        <div class="cake-card" data-name="Black Forest Cake"
             data-category="Birthday" data-flavor="Black Forest" data-price="600">
            <img src="https://images.unsplash.com/photo-1606313564200-e75d5e30476c?w=500"
                 alt="Black Forest cake">
            <h3>Black Forest Cake</h3>
            <p>Category: Birthday</p>
            <p>Flavor: Black Forest</p>
            <p>Chocolate sponge layered with cream.</p>
            <p class="price">₹600</p>
            <button onclick="selectCake('Black Forest Cake',600)">Add to Cart</button>
        </div>

    </div>
    <p id="noResults" hidden>No cakes match your search.</p>
</section>

<section id="cart">
    <h2>Shopping Cart</h2>
    <div id="cartItems">Your cart is empty.</div>

    <label>Cake Size</label>
    <select id="cakeSize">
        <option value="1">Small - 0.5 kg</option>
        <option value="1.5">Medium - 1 kg (+50% price)</option>
        <option value="2">Large - 2 kg (double price)</option>
    </select>

    <label>Message on Cake</label>
    <input type="text" id="cakeMessage"
           placeholder="Example: Happy Birthday">

    <h3 id="total">Total: ₹0</h3>
    <button onclick="updateCart()">Update Total</button>
</section>

<section id="shipping">
    <h2>Shipping Address</h2>
    <form id="orderForm" onsubmit="placeOrder(event)">
        <label>Customer Name</label>
        <input id="customerName" type="text"
               placeholder="Enter your name" required>

        <label>Phone Number</label>
        <input id="customerPhone" type="tel"
               placeholder="Enter phone number" required>

        <label>Delivery Address</label>
        <textarea id="address" placeholder="House number, street, city, PIN code"
                  required></textarea>

        <label>Delivery Location</label>
        <input id="location" type="text"
               placeholder="Enter delivery area" required>

        <label>Payment Method</label>
        <select id="payment">
            <option>Cash on Delivery</option>
            <option>UPI (Demo)</option>
            <option>Credit / Debit Card (Demo)</option>
        </select>

        <button type="submit">Place Order</button>
    </form>
    <p id="orderMessage"></p>
</section>

<section id="orders">
    <h2>My Orders</h2>
    <div id="myOrders">No orders placed yet.</div>
</section>

<section id="admin">
    <h2>Admin Login</h2>
    <form onsubmit="adminLogin(event)">
        <label>Admin Username</label>
        <input id="adminUser" type="text" placeholder="Enter username" required>

        <label>Password</label>
        <input id="adminPassword" type="password"
               placeholder="Enter password" required>

        <button type="submit">Admin Login</button>
    </form>
    <p id="adminMessage"></p>

    <div id="adminPanel" hidden>
        <h2>Manage Products</h2>
        <form onsubmit="addCake(event)">
            <label>Cake Name</label>
            <input id="newCakeName" type="text" required>

            <label>Price (₹)</label>
            <input id="newCakePrice" type="number" min="1" required>

            <label>Description</label>
            <textarea id="newCakeDescription" required></textarea>

            <button type="submit">Add Cake</button>
        </form>

        <h2>Manage Orders</h2>
        <div id="adminOrders">No orders to manage.</div>
    </div>
</section>

<footer>
    <p>© 2026 Sweet Treats Cake Shop | Online Cake Ordering System</p>
</footer>

<script>
let cart = [];
let orders = [];
let nextOrderId = 1001;

function filterCakes() {
    const search = document.getElementById("searchCake").value.toLowerCase();
    const category = document.getElementById("category").value;
    const flavor = document.getElementById("flavor").value;
    const maxPrice = Number(document.getElementById("maxPrice").value);
    const cards = document.querySelectorAll(".cake-card");
    let visible = 0;

    cards.forEach(card => {
        const name = card.dataset.name.toLowerCase();
        const cardCategory = card.dataset.category;
        const cardFlavor = card.dataset.flavor;
        const price = Number(card.dataset.price);

        const matches =
            name.includes(search) &&
            (category === "all" || cardCategory === category) &&
            (flavor === "all" || cardFlavor === flavor) &&
            price <= maxPrice;

        card.style.display = matches ? "block" : "none";
        if (matches) visible++;
    });

    document.getElementById("noResults").hidden = visible !== 0;
}

function selectCake(name, price) {
    const existing = cart.find(item => item.name === name);

    if (existing) {
        existing.quantity++;
    } else {
        cart.push({ name: name, price: price, quantity: 1 });
    }

    updateCart();
    alert(name + " added to cart!");
}

function updateCart() {
    const cartItems = document.getElementById("cartItems");

    if (cart.length === 0) {
        cartItems.textContent = "Your cart is empty.";
        document.getElementById("total").textContent = "Total: ₹0";
        return;
    }

    cartItems.innerHTML = "";
    let baseTotal = 0;

    cart.forEach((item, index) => {
        baseTotal += item.price * item.quantity;

        const row = document.createElement("p");
        row.textContent =
            item.name + " - ₹" + item.price +
            " × " + item.quantity + " ";

        const removeButton = document.createElement("button");
        removeButton.textContent = "Remove";
        removeButton.onclick = function () {
            cart.splice(index, 1);
            updateCart();
        };

        row.appendChild(removeButton);
        cartItems.appendChild(row);
    });

    const multiplier = Number(document.getElementById("cakeSize").value);
    document.getElementById("total").textContent =
        "Total: ₹" + Math.round(baseTotal * multiplier);
}

function placeOrder(event) {
    event.preventDefault();

    if (cart.length === 0) {
        alert("Please add a cake to your cart first.");
        return;
    }

    const multiplier = Number(document.getElementById("cakeSize").value);
    const total = Math.round(
        cart.reduce((sum, item) => sum + item.price * item.quantity, 0)
        * multiplier
    );

    const order = {
        id: nextOrderId++,
        customer: document.getElementById("customerName").value,
        phone: document.getElementById("customerPhone").value,
        address: document.getElementById("address").value,
        location: document.getElementById("location").value,
        payment: document.getElementById("payment").value,
        message: document.getElementById("cakeMessage").value,
        items: cart.map(item => ({ ...item })),
        total: total,
        status: "Order Placed"
    };

    orders.push(order);
    document.getElementById("orderMessage").textContent =
        "Order placed successfully! Order ID: " + order.id;

    cart = [];
    updateCart();
    document.getElementById("orderForm").reset();
    showOrders();
}

function showOrders() {
    const myOrders = document.getElementById("myOrders");
    const adminOrders = document.getElementById("adminOrders");

    myOrders.innerHTML = "";
    adminOrders.innerHTML = "";

    if (orders.length === 0) {
        myOrders.textContent = "No orders placed yet.";
        adminOrders.textContent = "No orders to manage.";
        return;
    }

    orders.forEach(order => {
        const customerOrder = document.createElement("p");
        customerOrder.textContent =
            "Order #" + order.id + " | " + order.items.map(i => i.name).join(", ") +
            " | Total: ₹" + order.total + " | Status: " + order.status;
        myOrders.appendChild(customerOrder);

        const box = document.createElement("div");
        box.style.border = "1px solid #e5b9c8";
        box.style.padding = "12px";
        box.style.margin = "10px 0";
        box.style.borderRadius = "8px";

        const details = document.createElement("p");
        details.textContent =
            "Order #" + order.id + " | Customer: " + order.customer +
            " | Phone: " + order.phone +
            " | Location: " + order.location +
            " | Address: " + order.address +
            " | Total: ₹" + order.total;
        box.appendChild(details);

        const status = document.createElement("select");
        [
            "Order Placed",
            "Confirmed",
            "Preparing",
            "Shipped",
            "Out for Delivery",
            "Delivered",
            "Cancelled"
        ].forEach(value => {
            const option = document.createElement("option");
            option.value = value;
            option.textContent = value;
            if (value === order.status) option.selected = true;
            status.appendChild(option);
        });

        status.onchange = function () {
            order.status = status.value;
            showOrders();
        };

        box.appendChild(status);
        adminOrders.appendChild(box);
    });
}

function adminLogin(event) {
    event.preventDefault();

    const username = document.getElementById("adminUser").value;
    const password = document.getElementById("adminPassword").value;

    // Demo credentials only. Do not use this for a real website.
    if (username === "admin" && password === "admin123") {
        document.getElementById("adminMessage").textContent =
            "Admin login successful.";
        document.getElementById("adminPanel").hidden = false;
        showOrders();
    } else {
        document.getElementById("adminMessage").textContent =
            "Invalid username or password.";
    }
}

function addCake(event) {
    event.preventDefault();

    const name = document.getElementById("newCakeName").value;
    const price = Number(document.getElementById("newCakePrice").value);
    const description = document.getElementById("newCakeDescription").value;

    const card = document.createElement("div");
    card.className = "cake-card";
    card.dataset.name = name;
    card.dataset.category = "Birthday";
    card.dataset.flavor = "Vanilla";
    card.dataset.price = price;

    const heading = document.createElement("h3");
    heading.textContent = name;

    const details = document.createElement("p");
    details.textContent = description;

    const cost = document.createElement("p");
    cost.className = "price";
    cost.textContent = "₹" + price;

    const addButton = document.createElement("button");
    addButton.textContent = "Add to Cart";
    addButton.onclick = function () {
        selectCake(name, price);
    };

    card.append(heading, details, cost, addButton);
    document.getElementById("cakeList").appendChild(card);

    document.getElementById("newCakeName").value = "";
    document.getElementById("newCakePrice").value = "";
    document.getElementById("newCakeDescription").value = "";

    alert("Cake added to the product list.");
}

document.getElementById("cakeSize").addEventListener("change", updateCart);
</script>

</body>
</html>